        "wages",
        "JOLTS",
        "claims"
      ]
    },
    {
      "id": "growth",
      "examples": [
        "GDP",
        "PMI",
        "retail_sales",
        "industrial_production",
        "trade"
      ]
    },
    {
      "id": "fiscal_liquidity",
      "examples": [
        "Treasury_refunding",
        "auction",
        "debt_ceiling",
        "TGA",
        "tax_deadline"
      ]
    },
    {
