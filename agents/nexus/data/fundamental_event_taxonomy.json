{
  "version": "1.1.0",
  "timezone": "Asia/Shanghai",
  "purpose": "Taxonomy and scoring rules for market-moving fundamental events",
  "cadence_seconds": {
    "normal": 1800,
    "p1_window": 900,
    "p0_or_release_window": 300
  },
  "priority": {
    "P0": {
      "min_score": 85,
      "notification": "immediate"
    },
    "P1": {
      "min_score": 70,
      "notification": "proactive"
    },
    "P2": {
      "min_score": 50,
      "notification": "record_only"
    }
  },
  "weights": {
    "historical_market_sensitivity": 25,
    "surprise_or_expectation_gap": 20,
    "transmission_breadth": 15,
    "time_proximity": 15,
    "source_credibility": 15,
    "market_fragility": 10
  },
  "source_tiers": {
    "A": [
      "government",
      "central_bank",
      "official_statistics",
      "regulator",
      "issuer_or_exchange_announcement"
    ],
    "B": [
      "Reuters",
      "Associated Press",
      "primary_market_venue_data"
    ],
    "C": [
      "institutional_research",
      "economist_consensus",
      "futures_options_positioning",
      "fund_flows"
    ],
    "D": [
      "social_media",
      "anonymous_claim",
      "prediction_market"
    ]
  },
  "categories": [
    {
      "id": "central_bank",
      "examples": [
        "rate_decision",
        "press_conference",
        "minutes",
        "liquidity_operation"
      ]
    },
    {
      "id": "inflation",
      "examples": [
        "CPI",
        "PPI",
        "PCE",
        "inflation_expectations"
      ]
    },
    {
      "id": "labor",
      "examples": [
        "payrolls",
