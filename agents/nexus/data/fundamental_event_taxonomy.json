        "supply_chain_policy"
      ]
    }
  ],
  "notification_gate": {
    "send_to_thread": "量化交易与技术分析系统",
    "thread_id": "019fb48a-9092-7833-a194-80241a3925d7",
    "minimum_priority": "P1",
    "requires": [
      "verified_fact",
      "impact_path",
      "scenario_analysis",
      "invalidation",
      "source_links"
    ],
    "no_change_notifications": false,
    "may_override_trading_risk_rules": false
  },
  "crypto_operational_gate": {
    "purpose": "monitoring_and_escalation_only_not_a_trading_signal_or_strategy_parameter",
    "p0_candidate": {
      "exchange": "confirmed_systemwide_matching_core_market_data_or_withdrawal_halt_at_a_major_venue",
      "stablecoin": "issuer_confirmed_redemption_halt_or_usdt_usdc_deviation_gte_1pct_on_two_independent_liquid_venues",
      "chain": "confirmed_loss_of_finality_or_major_network_outage",
      "security": "confirmed_attack_with_direct_major_trading_custody_bridge_or_settlement_contagion"
    },
    "p1_candidate": {
      "exchange": "persistent_multi_product_degradation_at_a_major_venue",
      "stablecoin": "usdt_usdc_deviation_0_5_to_1pct_on_two_independent_liquid_venues_for_at_least_15_minutes",
      "security": "major_single_protocol_incident_with_cross_venue_liquidity_collateral_or_liquidation_transmission"
    },
    "p2_default": "single_asset_maintenance_single_region_or_api_failure_planned_maintenance_or_contained_protocol_incident_without_contagion",
    "confirmation_requires": [
      "issuer_exchange_chain_or_protocol_primary_source_when_available",
      "cross_venue_executable_price_or_functionality_check",
      "market_structure_confirmation",
      "bad_tick_quote_currency_and_illiquid_pair_exclusion"
    ],
    "release_requires": [
      "official_recovery_or_incident_resolution",
      "first_party_functionality_recovery_evidence",
      "cross_venue_price_or_redemption_normalization"
    ],
    "release_limit": "solvency_reserve_or_key_compromise_events_cannot_be_cleared_by_status_page_recovery_alone"
  }
}
