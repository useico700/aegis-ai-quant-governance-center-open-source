//@version=6
indicator("SMC 结构观察器 v1.19 | 治理适配", shorttitle="SMC-v1.19", overlay=false, max_bars_back=2000, max_lines_count=500, max_labels_count=400, max_boxes_count=150)

// GOVERNANCE_METADATA_BEGIN
const string governanceRevision = "SMC-CONTEXT-2 / SMC-ENTRY-REVIEW-3 / SMC-STRUCTURE-PLAN-2 / SMC-OPPORTUNITY-SEARCH-1 / SMC-PLAN-LIFECYCLE-1"
const string governanceFingerprint = "b9c392e2aeca"
const int governanceReviewedAt = 1791489051152
const int governanceValidUntil = 1792093851152
// GOVERNANCE_METADATA_END

// Original visual observer, not the source video's code and not an execution system.
// Closed-bar events. Newly confirmed pivots become eligible on the NEXT bar.
// State: 0 unknown, 1 bullish, -1 bearish, 2 transition.
// Events: 1 BOS, 2 CHoCH, 3 trend established, 4 counter-direction internal break,
//         5 unconfirmed break. Each endpoint is consumed once.
compactView = input.bool(true, "直观布局", group="00 · 常用显示", display=display.none, tooltip="紧凑多周期表、当前水平边界与独立动能副图；关闭后恢复详细表格。只改变显示。")
clearCandles = input.bool(true, "K线避让布局", group="00 · 常用显示", display=display.none, tooltip="价位和区域文字放在最新K线右侧，细引线指向真实价格；历史事件放在影线外。仅调整绘图，不改变结构、交汇或警报。请保留约25根右侧空白；Pine无法读取字体像素边界。")
annotationGap = input.int(10, "右侧文字距离 / 根", minval=4, maxval=60, group="00 · 常用显示", display=display.none, active=clearCandles, tooltip="文字从最新K线右侧此距离起向右展开；不要把右侧留白全部收起。")
annotationSpacing = input.float(0.45, "标签间隔 / ATR", minval=0.2, maxval=2, step=0.05, group="00 · 常用显示", display=display.none, active=clearCandles, tooltip="右侧标签按价格排列并保持最小间距；文字价格和引线起点始终是真实价位，标签高度可能避让。")
eventWords = input.bool(false, "展开事件全称", group="00 · 常用显示", display=display.none, tooltip="默认使用BOS、CHoCH、HH/HL和扫高/扫低等短标记，完整含义在悬停提示。")
showLevelHistory = input.bool(false, "历史边界轨迹", group="00 · 常用显示", display=display.none, tooltip="默认只画当前外部边界和保护点的水平段；开启可回看历史迁移。不是额外买卖信号。")
showCandlePanel = input.bool(true, "K线特征", display=display.none, group="00 · 常用显示", tooltip="显示已收盘K线的形态、实体和影线占比；不单独决定方向。", inline="overview")
showLevels = input.bool(true, "外部边界与保护点", display=display.none, group="00 · 常用显示", tooltip="外部推进边界优先；保护线是趋势失效界，不等于交易止损。局部摆动单独勾选。", inline="structure")
showLocalLevels = input.bool(false, "局部摆动高低", display=display.none, group="00 · 常用显示", tooltip="最近N窗口高低，可能属于外部结构内部波动；不代替外部边界。")
showSweep = input.bool(true, "扫点收回", display=display.none, group="00 · 常用显示", tooltip="越过已确认主高/低后，同一根收盘回到该点内。只标首次扫点，不代表反转成立。", inline="structure")
showPivots = input.bool(false, "HH / HL / LH / LL", display=display.none, group="00 · 常用显示", tooltip="标记主摆动序列，默认放在确认K线；窗口8意味着要等待右侧8根确认。", inline="marks")
showInner = input.bool(false, "内部事件", display=display.none, group="00 · 常用显示", tooltip="显示灰色内部破点；仅作辅助，不能替代主结构。", inline="marks")
showBg = input.bool(false, "方向背景", display=display.none, group="00 · 常用显示", tooltip="淡色背景对应主结构方向。", inline="background")
showMid = input.bool(false, "区间50%", display=display.none, group="00 · 常用显示", tooltip="保护点和对向主摆动构成区间的中点；不是FVG的CE或影线中点。", inline="background")
showFvg = input.bool(true, "FVG 失衡区", display=display.none, group="01 · 区域与透明度", tooltip="三根收线确认；默认精选位移与结构相关缺口，全部模式查看其余候选。完全回补或超龄才删除；精选隐藏不等于失效。", inline="fvg")
showCe = input.bool(true, "CE 中线", display=display.none, group="01 · 区域与透明度", tooltip="单个FVG的50%中线；只在FVG开启时显示。", inline="fvg", active=showFvg)
fvgMode = input.string("精选FVG", "FVG 显示模式", options=["精选FVG", "全部FVG"], display=display.none, group="01 · 区域与透明度", active=showFvg, tooltip="精选：位移、宽度、结构相关与回补/距离排序，同向重叠去重。全部：寿命与原始宽度内候选，仍受绘图数量限制；非无限历史。均为展示启发式，不代表胜率。")
fvgSelectedMax = input.int(4, "精选最多 / 个", minval=1, maxval=8, display=display.none, group="01 · 区域与透明度", active=showFvg and fvgMode == "精选FVG", tooltip="按代表性排序，不按最近FIFO；不改变缺口边界或主结构。")
showOb = input.bool(false, "突破位移 OB 候选", display=display.none, group="01 · 区域与透明度", tooltip="仅主BOS/趋势建立与位移同根；回溯首个反向K，若不合格不继续找更早K。不是所有OB或真实机构订单，可选展示。", inline="zones")
showLiquidity = input.bool(false, "BSL / SSL", display=display.none, group="01 · 区域与透明度", tooltip="最近未扫、未突破的主高低参考带；不是真实交易所挂单量。", inline="zones")
showPd = input.bool(false, "溢价 / 折价", display=display.none, group="01 · 区域与透明度", tooltip="当前保护点与对向主摆动的区间上下半部；过渡、未建立或区间无效时不显示。")
zoneTransparency = input.int(84, "透明度 %", minval=50, maxval=95, display=display.none, group="01 · 区域与透明度", tooltip="数值越大越淡，84表示84%透明。也作用于SL/TP参考区域。")
zoneExtend = input.int(12, "向右延伸 / 根", minval=1, maxval=100, display=display.none, group="01 · 区域与透明度", tooltip="把区域延伸到最新K线右侧；建议图表右留白至少50根。")
fvgColor = input.color(color.rgb(56,121,255), "FVG颜色", display=display.none, group="01 · 区域与透明度", tooltip="FVG区域颜色。", inline="zone-colors", active=showFvg)
obColor = input.color(color.rgb(186,156,230), "OB颜色", display=display.none, group="01 · 区域与透明度", tooltip="OB候选区域颜色。", inline="zone-colors", active=showOb)
showSl = input.bool(false, "SL 风险区", display=display.none, group="02 · 历史 / 手动测量", tooltip="入场到止损的价格区间；这是参考图，不是真实订单。", inline="plan")
showTp = input.bool(false, "TP 目标区", display=display.none, group="02 · 历史 / 手动测量", tooltip="入场到目标的价格区间；价格触线不代表成交。", inline="plan")
planMode = input.string("历史毛R测量", "价格来源", options=["历史毛R测量", "手动价格"], display=display.none, group="02 · 历史 / 手动测量", tooltip="历史测量：过去主BOS/建立后冻结收盘价、保护点及固定R，画在形成时间，不代表当前计划。手动价格：按下一组填写的价格画图。固定R不等于生产策略的结构目标或成本后净R。", active=showSl or showTp)
planR1 = input.float(1.0, "TP1 / R", minval=0.25, maxval=10, step=0.25, display=display.none, group="02 · 历史 / 手动测量", tooltip="毛价格距离倍数，未计手续费、滑点和资金费。", inline="rewards", active=(showSl or showTp) and planMode == "历史毛R测量")
planR2 = input.float(2.0, "TP2 / R", minval=0.5, maxval=20, step=0.25, display=display.none, group="02 · 历史 / 手动测量", tooltip="TP2必须大于TP1。1R/2R是观察尺，不是治理生产候选的净2R准入。", inline="rewards", active=(showSl or showTp) and planMode == "历史毛R测量")
planSlAtr = input.float(0.10, "SL 缓冲 / ATR", minval=0, maxval=2, step=0.05, display=display.none, group="02 · 历史 / 手动测量", tooltip="观察尺的保护点外缓冲，至少1tick；未核验生产止损安全门（波动、流动性、Tick/BBO、费用）。已有参考计划冻结。", active=(showSl or showTp) and planMode == "历史毛R测量")
planAge = input.int(200, "最长观察 / 根", minval=10, maxval=1000, display=display.none, group="02 · 历史 / 手动测量", tooltip="自动参考计划超龄或主CHoCH、SL、TP2触及后结束；同根SL与TP2触及时标路径未知。仅在创建后的K线检查触价，不回填成交；后续新主事件可建立新参考，未实现生产锚点族永久失效台账。", active=(showSl or showTp) and planMode == "历史毛R测量")
slColor = input.color(color.rgb(176,146,228), "SL颜色", display=display.none, group="02 · 历史 / 手动测量", tooltip="止损风险区颜色。", inline="plan-colors", active=showSl)
tpColor = input.color(color.rgb(79,150,240), "TP颜色", display=display.none, group="02 · 历史 / 手动测量", tooltip="止盈目标区颜色。", inline="plan-colors", active=showTp)
manualDirection = input.string("多头", "参考方向", options=["多头", "空头"], display=display.none, group="03 · 手动价格", tooltip="先在上一组把价格来源切换为手动价格，下面的价格才可编辑。", active=(showSl or showTp) and planMode == "手动价格")
manualEntry = input.float(0, "参考入场", minval=0, display=display.none, group="03 · 手动价格", tooltip="0表示未设置。价格必须来自当前图表品种。", active=(showSl or showTp) and planMode == "手动价格")
manualSl = input.float(0, "止损 SL", minval=0, display=display.none, group="03 · 手动价格", tooltip="多头：SL < 入场 < TP1 < TP2；空头顺序相反。所有价格必须大于0。", active=(showSl or showTp) and planMode == "手动价格")
manualTp1 = input.float(0, "目标 TP1", minval=0, display=display.none, group="03 · 手动价格", tooltip="第一目标；仅画参考线，不做触线成交推断。", active=(showSl or showTp) and planMode == "手动价格")
manualTp2 = input.float(0, "目标 TP2", minval=0, display=display.none, group="03 · 手动价格", tooltip="第二目标；手动模式不会因结构变化自动修改你填写的价格。", active=(showSl or showTp) and planMode == "手动价格")
showBodyHistogram = input.bool(true, "实体动能副图", group="04 · K线与市场动能", display=display.none, tooltip="已收盘K线的有符号实体/前ATR14，阳线为正、阴线为负；当前未收线留空，不回填未来数据。浅蓝折线与灰色零线；关闭只隐藏曲线，不改变计算。")
useReferenceCandles = input.bool(true, "参考红绿K线", group="04 · K线与市场动能", display=display.none, tooltip="阳线亮绿、阴线红。可叠加已收盘关键形态高亮。")
momentumMode = input.string("已收盘", "读数时点", options=["已收盘", "盘中参考"], display=display.none, group="04 · K线与市场动能", tooltip="已收盘：盘中读取上一根完成K。盘中参考：当前K随行情更新，明确标未确认。结构事件仍只在收盘确认。")
showRsi = input.bool(true, "RSI", display=display.none, group="04 · K线与市场动能", tooltip=">=55偏强，<=45偏弱，其余中性。不是买卖指令。", inline="momentum")
showRvol = input.bool(true, "相对成交量", display=display.none, group="04 · K线与市场动能", tooltip="当前量除以前N根已收盘平均量；分母不含当前柱。", inline="momentum")
showBodyAtr = input.bool(true, "实体 / ATR", display=display.none, group="04 · K线与市场动能", tooltip="实体相对前一根ATR14的大小，辅助观察推进强度。", inline="momentum")
showCandleHighlight = input.bool(false, "关键K线着色", display=display.none, group="04 · K线与市场动能", tooltip="收盘确认后高亮位移、吞没、长影等候选。", inline="candles")
showCandleLabels = input.bool(false, "形态标签", display=display.none, group="04 · K线与市场动能", tooltip="每根最多一个标签，优先位移、吞没、长影、小实体。", inline="candles")
rsiLen = input.int(14, "RSI 周期", minval=2, maxval=100, display=display.none, group="04 · K线与市场动能", tooltip="RSI计算长度；默认14。", inline="periods", active=showRsi)
volLen = input.int(20, "量均周期", minval=2, maxval=100, display=display.none, group="04 · K线与市场动能", tooltip="相对成交量分母使用此前N根已收盘量。", inline="periods", active=showRvol)
rvolThreshold = input.float(1.5, "放量阈值 / 倍", minval=1, step=0.1, display=display.none, group="04 · K线与市场动能", tooltip="相对均量达到此倍数标放量；不等于主动买盘。", active=showRvol)
displacementAtr = input.float(1.0, "位移实体 / ATR", minval=0.25, maxval=5, step=0.25, display=display.none, group="04 · K线与市场动能", tooltip="同时要求实体占比>=60%、收盘位于方向末端20%；也是OB候选的位移筛选条件。")
hideAllPanels = input.bool(false, "隐藏全部面板", display=display.none, group="05 · 面板与阅读", tooltip="只隐藏四块文字面板，结构/FVG/SLTP图形和交汇时间竖线继续计算与显示。取消后恢复各面板选择。")
showPanel = input.bool(true, "主结构面板", display=display.none, group="05 · 面板与阅读", tooltip="右上只显示4H外部背景和15M局部背景；图上形态仍按当前图表周期计算。两个周期独立观察，不投票、不作订单准入。")
showMomentumPanel = input.bool(true, "K线动能面板", display=display.none, group="05 · 面板与阅读", tooltip="只隐藏整块动能表；K线特征/RSI等内容选择及着色计算保持。")
showPlanPanel = input.bool(true, "历史测量面板", display=display.none, group="05 · 面板与阅读", tooltip="只隐藏底部冻结计划文字；SL/TP区域与参考生命周期保持。")
showMeetPanel = input.bool(true, "交汇时间面板", display=display.none, group="05 · 面板与阅读", tooltip="交汇时间摘要位于下方指标窗，不覆盖K线。关闭只隐藏摘要；准确时间竖线与来源计算保持。")
structurePosition = input.string("右上", "结构面板位置", options=["右上", "左上"], group="05 · 面板与阅读", tooltip="右侧SL/TP标签被遮挡时，可把结构面板移到左上。", display=display.none, active=showPanel)
momentumPosition = input.string("右下", "动能面板位置", options=["右下", "左下", "左上"], display=display.none, group="05 · 面板与阅读", tooltip="可放右下、左下、左上；若与结构面板同在左上，动能自动移到左下。", active=showCandlePanel or showRsi or showRvol or showBodyAtr)
panelFont = input.string("标准", "面板字号", options=["紧凑", "标准", "大字"], group="05 · 面板与阅读", tooltip="大字便于手机截图查看；面板会占用更多图表空间。", display=display.none)
panelDetail = input.bool(false, "展开保护点与时间", display=display.none, group="05 · 面板与阅读", tooltip="同一源快照的保护/外部边界/最近外部事件/确认时刻；统一北京时间 UTC+8。低周期快照可能额外滞后一根源周期K；详情注明已确认至。", active=showPanel)
panelBackground = input.color(color.rgb(5,6,8), "面板背景", display=display.none, group="05 · 面板与阅读", tooltip="面板背景色，配合图表明暗主题选择。")
editAdvanced = input.bool(false, "解锁高级参数", group="06 · 高级结构与区域规则", tooltip="只控制下面参数能否编辑，不会切换或重置算法。调整后会重算已加载历史，既有警报需重建。", display=display.none)
mainLen = input.int(8, "主结构 / 根", minval=3, maxval=50, display=display.none, group="06 · 高级结构与区域规则", tooltip="左右各N根确认；15M默认8根约2小时确认延迟。该观察窗口与生产2×2结构基元不同。", inline="swing", active=editAdvanced)
innerLen = input.int(2, "内部 / 根", minval=1, maxval=20, display=display.none, group="06 · 高级结构与区域规则", tooltip="必须小于主结构窗口。用于识别主结构中的小波动。", inline="swing", active=editAdvanced)
bufferAtr = input.float(0.05, "突破缓冲 / ATR", minval=0, maxval=1, step=0.01, display=display.none, group="06 · 高级结构与区域规则", tooltip="使用上一根ATR14，实际缓冲取ATR部分与最小tick部分的较大值。", active=editAdvanced)
bufferTicks = input.int(1, "最小突破 / tick", minval=0, maxval=100, display=display.none, group="06 · 高级结构与区域规则", tooltip="一个tick等于当前品种最小报价单位。", active=editAdvanced)
equalTicks = input.int(1, "等高低容差 / tick", minval=0, maxval=100, display=display.none, group="06 · 高级结构与区域规则", tooltip="容差内归为等高/等低，避免报价微差制造新结构。", active=editAdvanced)
fvgMinAtr = input.float(0.10, "FVG 最小宽度 / ATR", minval=0, step=0.05, display=display.none, group="06 · 高级结构与区域规则", tooltip="小于该阈值的缺口不创建。", active=editAdvanced and showFvg)
fvgAge = input.int(200, "区域寿命 / 根", minval=10, maxval=1000, display=display.none, group="06 · 高级结构与区域规则", tooltip="FVG与OB共用的最长保留根数。", active=editAdvanced and (showFvg or showOb))
fvgMax = input.int(10, "全部模式最多 FVG", minval=1, maxval=20, display=display.none, group="06 · 高级结构与区域规则", tooltip="仅限制全部模式绘图数量，按代表性排序；不丢弃寿命内候选。", inline="caps", active=editAdvanced and showFvg and fvgMode == "全部FVG")
fvgSelectedAtr = input.float(0.20, "精选宽度 / ATR", minval=0, maxval=2, step=0.05, display=display.none, group="06 · 高级结构与区域规则", active=editAdvanced and showFvg, tooltip="精选缺口至少此倍数前ATR且>=2tick，仍需满足原始最小宽度。展示阈值未校准盈利能力。")
fvgImpulseAtr = input.float(0.8, "精选中K实体 / ATR", minval=0.25, maxval=3, step=0.05, display=display.none, group="06 · 高级结构与区域规则", active=editAdvanced and showFvg, tooltip="中间K同向、实体>=此前ATR倍数、实体占比>=60%、收盘在方向末端20%。与动能/OB位移阈值独立。")
fvgMaxFill = input.int(75, "精选隐藏回补 / %", minval=25, maxval=100, display=display.none, group="06 · 高级结构与区域规则", active=editAdvanced and showFvg, tooltip="已收盘影线累计回补达到此比例，仅从精选隐藏；全部模式保留至完全填补或超龄。")
