//@version=6
indicator("Crypto Regime 5-State v1", overlay = true, max_labels_count = 100)

int adxLength = input.int(14, "ADX长度", minval = 5)
int rangeLength = input.int(20, "突破区间", minval = 10)
bool colorBars = input.bool(true, "K线按状态着色")
bool sendThreeHourReport = input.bool(true, "每3小时发送一次状态alert")

float ema20 = ta.ema(close, 20)
float ema50 = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)
float atr14 = ta.atr(14)
[plusDI, minusDI, adx14] = ta.dmi(adxLength, adxLength)
float basis = ta.sma(close, 20)
float bbWidth = basis == 0.0 ? 0.0 : 4.0 * ta.stdev(close, 20) / basis
float bbMin = ta.lowest(bbWidth, 100)
float bbMax = ta.highest(bbWidth, 100)
float bbRank = bbMax == bbMin ? 0.5 : math.max(0.0, math.min(1.0, (bbWidth - bbMin) / (bbMax - bbMin)))
float atrRatio = atr14 / close
float atrMin = ta.lowest(atrRatio, 100)
float atrMax = ta.highest(atrRatio, 100)
float atrRank = atrMax == atrMin ? 0.5 : math.max(0.0, math.min(1.0, (atrRatio - atrMin) / (atrMax - atrMin)))
float volumeMean = ta.sma(volume, 30)
float volumeStd = ta.stdev(volume, 30)
float volumeZ = volumeStd == 0.0 ? 0.0 : (volume - volumeMean) / volumeStd
float safeAtr = math.max(atr14, close * 1e-9)
float emaSpreadAtr = math.abs(ema20 - ema50) / safeAtr
float emaSlopeAtr = (ema20 - ema20[5]) / safeAtr
float priorHigh = ta.highest(high[1], rangeLength)
float priorLow = ta.lowest(low[1], rangeLength)
float breakoutDistance = math.max((close - priorHigh) / safeAtr, (priorLow - close) / safeAtr)
float breakoutStrength = 1.0 / (1.0 + math.exp(-(breakoutDistance - 0.05) * 5.0))

float compression = math.max(0.0, math.min(1.0,
     0.45 * (1.0 - bbRank) +
     0.30 * (1.0 - atrRank) +
     0.25 * (1.0 - math.min(1.0, emaSpreadAtr / 1.5))))
float trendStrength = math.max(0.0, math.min(1.0, (adx14 - 15.0) / 25.0))
float adxDelta = adx14 - adx14[5]
float trendRising = 1.0 / (1.0 + math.exp(-adxDelta / 3.0))
float trendFalling = 1.0 / (1.0 + math.exp(adxDelta / 3.0))
bool bullAligned = ema20 > ema50 and ema50 > ema200
bool bearAligned = ema20 < ema50 and ema50 < ema200
float alignment = bullAligned or bearAligned ? 1.0 : math.min(1.0, emaSpreadAtr / 1.5) * 0.55
float moderateAdx = math.max(0.0, math.min(1.0, 1.0 - math.abs(adx14 - 23.0) / 13.0))
float priorStrength = math.max(0.0, math.min(1.0, (ta.highest(adx14[5], 10) - 22.0) / 18.0))
float fastMaViolation = math.min(1.0, math.abs(close - ema20) / safeAtr / 1.5)
float volatilityExpansion = math.max(0.0, math.min(1.0, (atrRank - 0.45) / 0.45))
float volumeExpansion = math.max(0.0, math.min(1.0, (volumeZ + 0.5) / 2.5))
float insideRange = close <= priorHigh and close >= priorLow ? 1.0 : 0.0

float scoreRange = 0.35 + 2.20 * compression + 0.95 * (1.0 - trendStrength) + 0.35 * insideRange
float scoreBreakout = 0.20 + 2.35 * breakoutStrength + 0.70 * volumeExpansion + 0.70 * volatilityExpansion + 0.45 * trendRising
float scoreStart = 0.20 + 1.55 * alignment * trendRising + 0.85 * moderateAdx * alignment + 0.65 * breakoutStrength
float scoreMiddle = 0.20 + 1.75 * alignment * trendStrength + 0.80 * alignment + 0.65 * trendStrength + 0.40 * (1.0 - compression)
float scoreFade = 0.20 + 1.25 * priorStrength + 1.25 * trendFalling + 0.85 * compression + 0.45 * fastMaViolation

float temperature = 0.72
float expRange = math.exp(scoreRange / temperature)
float expBreakout = math.exp(scoreBreakout / temperature)
float expStart = math.exp(scoreStart / temperature)
float expMiddle = math.exp(scoreMiddle / temperature)
float expFade = math.exp(scoreFade / temperature)
float expTotal = expRange + expBreakout + expStart + expMiddle + expFade
float probRange = expRange / expTotal
float probBreakout = expBreakout / expTotal
float probStart = expStart / expTotal
float probMiddle = expMiddle / expTotal
float probFade = expFade / expTotal

float maxProbability = math.max(probRange, math.max(probBreakout, math.max(probStart, math.max(probMiddle, probFade))))
string state = maxProbability == probRange ? "盘整" : maxProbability == probBreakout ? "突破" : maxProbability == probStart ? "趋势开始" : maxProbability == probMiddle ? "趋势中期" : "趋势转盘整"
string direction = plusDI > minusDI and emaSlopeAtr > 0 ? "上行结构" : plusDI < minusDI and emaSlopeAtr < 0 ? "下行结构" : "无明显方向"
color stateColor = state == "盘整" ? color.gray : state == "突破" ? color.yellow : state == "趋势开始" ? color.aqua : state == "趋势中期" ? color.lime : color.orange

plot(ema20, "EMA20", color = color.new(color.aqua, 0))
plot(ema50, "EMA50", color = color.new(color.orange, 0))
plot(ema200, "EMA200", color = color.new(color.purple, 0))
barcolor(colorBars ? color.new(stateColor, 55) : na)
bgcolor(color.new(stateColor, 92))

var table dashboard = table.new(position.top_right, 2, 8, border_width = 1)
if barstate.islast
    table.cell(dashboard, 0, 0, "状态", bgcolor = stateColor)
    table.cell(dashboard, 1, 0, state + " " + str.tostring(maxProbability * 100.0, "#.0") + "%", bgcolor = stateColor)
    table.cell(dashboard, 0, 1, "当前结构")
    table.cell(dashboard, 1, 1, direction)
    table.cell(dashboard, 0, 2, "盘整")
    table.cell(dashboard, 1, 2, str.tostring(probRange * 100.0, "#.0") + "%")
    table.cell(dashboard, 0, 3, "突破")
    table.cell(dashboard, 1, 3, str.tostring(probBreakout * 100.0, "#.0") + "%")
    table.cell(dashboard, 0, 4, "趋势开始")
    table.cell(dashboard, 1, 4, str.tostring(probStart * 100.0, "#.0") + "%")
    table.cell(dashboard, 0, 5, "趋势中期")
    table.cell(dashboard, 1, 5, str.tostring(probMiddle * 100.0, "#.0") + "%")
    table.cell(dashboard, 0, 6, "趋势转盘整")
    table.cell(dashboard, 1, 6, str.tostring(probFade * 100.0, "#.0") + "%")
    table.cell(dashboard, 0, 7, "ADX / 量Z")
    table.cell(dashboard, 1, 7, str.tostring(adx14, "#.0") + " / " + str.tostring(volumeZ, "#.00"))

bool stateChanged = barstate.isconfirmed and state != state[1]
bool threeHourClose = barstate.isconfirmed and timeframe.in_seconds() <= 3600 and minute(time_close, "UTC") == 0 and hour(time_close, "UTC") % 3 == 0
string alertMessage = syminfo.tickerid + " | " + timeframe.period + " | " + state + " " + str.tostring(maxProbability * 100.0, "#.0") + "% | " + direction + " | ADX " + str.tostring(adx14, "#.0")
if stateChanged
    alert("状态切换 | " + alertMessage, alert.freq_once_per_bar_close)
if sendThreeHourReport and threeHourClose
    alert("三小时汇报 | " + alertMessage, alert.freq_once_per_bar_close)

alertcondition(stateChanged, "五状态发生切换", "五状态发生切换")
